# Same-origin API path used by local development and the production Vercel rewrite.
# Include the API prefix.
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Production authentication must use the Vercel /api rewrite so cookies remain
# first-party; the production API client ignores direct backend URL overrides.